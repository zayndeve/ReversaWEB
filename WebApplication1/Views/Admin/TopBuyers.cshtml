@model dynamic
@{
    ViewData["Title"] = "Top Buyers";
    Layout = "_Layout";
}

<link rel="stylesheet" href="@Url.Content("~/css/dashboard.css")" />
<link rel="stylesheet" href="@Url.Content("~/css/billing.css")" />
<link rel="stylesheet" href="@Url.Content("~/css/common.css")" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="dashboard-page">
    <div class="dashboard-layout">

        <!-- Sidebar -->
        @await Html.PartialAsync("includes/_SideBar", model: null)

        <!-- Main Content -->
        <div class="dashboard-content">
            @await Html.PartialAsync("includes/_Navbar", model: null)

            <!-- CHART SECTION (Two-column layout) -->
            <div class="chart-section">
                <div class="chart-summary-box">
                    <div class="chart-left">
                        <h2>Top Categories Overview</h2>
                        <div class="summary-metrics">
                            <p class="revenue-text">
                                <i class="fa-solid fa-sack-dollar"></i>
                                Total Revenue: <span id="totalRevenueText">$0</span>
                            </p>
                            <p class="orders-text">
                                <i class="fa-solid fa-box"></i>
                                Total Orders: <span id="totalOrdersText">0</span>
                            </p>
                        </div>
                    </div>

                    <div class="chart-right">
                        <canvas id="categoryPieChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- TOP BUYERS TABLE -->
            <div class="leaderboard">
                <h3>Top Buyers</h3>
                <table class="top-buyers-table">
                    <thead>
                        <tr>
                            <th>Rank</th>
                            <th>Member</th>
                            <th>Total Spent</th>
                            <th>Last Purchase</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.topBuyers != null && Model.topBuyers.Count > 0)
                        {
                            int index = 0;
                            foreach (dynamic buyer in Model.topBuyers)
                            {
                                <tr>
                                    <td class="rank-cell">
                                        @if (index == 0)
                                        {
                                            <i class="fa-solid fa-trophy first-rank"></i>
                                        }
                                        else if (index == 1)
                                        {
                                            <i class="fa-solid fa-medal second-rank"></i>
                                        }
                                        else if (index == 2)
                                        {
                                            <i class="fa-solid fa-award third-rank"></i>
                                        }
                                        else
                                        {
                                            <span class="rank-number">@((index + 1).ToString("D2"))</span>
                                        }
                                    </td>
                                    <td><span class="buyer-name">@buyer.Nickname</span></td>
                                    <td><span class="buyer-amount">$@buyer.TotalSpentFormatted</span></td>
                                    <td>@buyer.LastPurchaseFormatted</td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr><td colspan="4">No buyer data available</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- JSON DATA -->
    <script id="monthlySalesData" type="application/json">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.monthlySales).Replace("<", "\\u003c"))
    </script>
    <script id="categoryData" type="application/json">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.topCategories).Replace("<", "\\u003c"))
    </script>

    <!-- Chart.js INIT -->
    <script>
        let salesData = [];
        let categoryData = [];

        try {
            const salesRaw = document.getElementById("monthlySalesData").textContent.trim();
            salesData = JSON.parse(salesRaw);
        } catch {}

        try {
            const categoryRaw = document.getElementById("categoryData").textContent.trim();
            categoryData = JSON.parse(categoryRaw);
        } catch {}

        if (!Array.isArray(salesData) || salesData.length === 0)
            salesData = [{ total: 0, orders: 0 }];
        if (!Array.isArray(categoryData) || categoryData.length === 0)
            categoryData = [{ name: "No Data", value: 1 }];

        const totalRevenue = salesData.reduce((sum, s) => sum + (s.total ?? s.Total ?? 0), 0);
        const totalOrders = salesData.reduce((sum, s) => sum + (s.orders ?? s.Orders ?? 0), 0);
        document.getElementById("totalRevenueText").textContent = "$" + totalRevenue.toLocaleString();
        document.getElementById("totalOrdersText").textContent = totalOrders.toLocaleString();

        new Chart(document.getElementById("categoryPieChart"), {
            type: "pie", // ✅ full pie instead of hollow doughnut
            data: {
                labels: categoryData.map(c => c.name ?? c.Name),
                datasets: [{
                    data: categoryData.map(c => c.value ?? c.Value),
                    backgroundColor: [
                        "#7b61ff", "#2196f3", "#4caf50", "#ff9800", "#e91e63",
                    ],
                    borderColor: "#fff",
                    borderWidth: 3,
                }],
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: "bottom",
                        labels: {
                            color: "#333",
                            font: { size: 14, weight: "500" },
                            usePointStyle: true,
                        },
                    },
                    tooltip: {
                        backgroundColor: "#fff",
                        borderColor: "#eee",
                        borderWidth: 1,
                        titleColor: "#333",
                        bodyColor: "#555",
                        callbacks: {
                            label: ctx => `${ctx.label}: $${ctx.parsed.toLocaleString()}`,
                        },
                    },
                },
            },
        });
    </script>
</div>
